  "sections": [
    {
      "title": "记住一件事，也是在记住它与生活的关系",
      "source_seconds": 474.83
    },
    {
      "title": "无聊的材料，也会因为重复变得熟悉",
      "source_seconds": 832.21
    },
    {
      "title": "有时重复很多遍，有时一次就留下来",
      "source_seconds": 1031.95
    },
    {
      "title": "刚看过的验证码，与多年后仍会走路，不是同一种保留",
      "source_seconds": 1250.42
    },
    {
      "title": "HM能留下旧生活，却留不住刚才的见面",
      "source_seconds": 1707.56
    },
    {
      "title": "他不记得听过笑话，为什么笑得越来越少",
      "source_seconds": 1963.13
    },
    {
      "title": "情绪更强的段落，后来记得更清楚",
      "source_seconds": 2204.29
    },
    {
      "title": "小鼠躲开那块地方，也会重返得到奖励的位置",
      "source_seconds": 2539.97
    },
    {
      "title": "平淡短文之后的一次冷刺激，改变了后来的记忆",
      "source_seconds": 2759.87
    },
    {
      "title": "情绪与化学状态相关，却不是可以互换的两个词",
      "source_seconds": 2834.67
    },
    {
      "title": "先喝咖啡，还是学完再提高警觉",
      "source_seconds": 3200.27
    },
    {
      "title": "后面的睡眠仍然重要，却不一定要紧接着学习",
      "source_seconds": 3649.98
    },
    {
      "title": "可以讨论冷刺激与运动，不能把它变成自行用药的理由",
      "source_seconds": 3827.45
    },
    {
      "title": "关键是短时增幅，不是把警觉全天维持在高处",
      "source_seconds": 4138.22
    },
    {
      "title": "一则古老的河水故事，说明不了安全，却提示了时机",
      "source_seconds": 4511.66
    },
    {
      "title": "杏仁核怎样把先前的活动与后来的状态接起来",
      "source_seconds": 4645.36
    },
    {
      "title": "运动能帮助记忆，不必先把成人神经元新生说成定论",
      "source_seconds": 4940.91
    },
    {
      "title": "骨骼发出的信号，也可能抵达海马体",
      "source_seconds": 5224.45
    },
    {
      "title": "身体在移动，也是在告诉脑它仍需要更新",
      "source_seconds": 5397.57
    },
    {
      "title": "运动放在学习前还是学习后，取决于想借哪条路径",
      "source_seconds": 5681.72
    },
    {
      "title": "过目不忘、善认人脸，也不是一切记忆都更好",
      "source_seconds": 5867.01
    },
    {
      "title": "自己选着拍，视觉记得更好，声音却可能留得更少",
      "source_seconds": 6126.74
    },
    {
      "title": "没有相机，也可以有意留下一个画面",
      "source_seconds": 6486.33
    },
    {
      "title": "既视感：熟悉的行为反应，不等于已证明人的主观体验",
      "source_seconds": 6550.71
    },
    {
      "title": "十三分钟，八周，与同样时长听播客作比较",
      "source_seconds": 6802.14
    },
    {
      "title": "记忆改善了，睡眠质量却比对照更差",
      "source_seconds": 7039.65
    },
    {
      "title": "平静而专注，与低注意的深度放松，目的可以不同",
      "source_seconds": 7140.5
    },
    {
      "title": "留下来的不是所有刺激，也不只是一种分子",
      "source_seconds": 7340.2
    }
  ]
}
