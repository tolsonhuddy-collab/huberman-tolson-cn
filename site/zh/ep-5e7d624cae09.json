  "sections": [
    {
      "title": "稳固，不是硬起来，而是同时保有自己和对方",
      "source_seconds": 552.03,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "真正的边界，不能完全寄托在对方愿意配合",
      "source_seconds": 929.87,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "边界与共情可以同时存在，孩子也可以继续不高兴",
      "source_seconds": 1222.87,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "奖励与惩罚之外，她想把注意力放回技能",
      "source_seconds": 1444.43,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "孩子不想去，成人仍可以作决定，也可以相信他的失望",
      "source_seconds": 2207.119,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "“我相信你”相信的是什么：体验，而非所有推断",
      "source_seconds": 2702.71,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "孩子的自责与自疑，是她理解修复重要性的一条线索",
      "source_seconds": 3169.67,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "成人先承担自己的情绪，才不必让孩子负责原谅",
      "source_seconds": 3458.109,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "“我讨厌你”出现时，可以先不把冲突打回去",
      "source_seconds": 3998.91,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "“感受很深的孩子”不是诊断，更不是坏孩子的新名字",
      "source_seconds": 4519.55,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "强烈情绪面前，既不投降，也不靠压倒孩子取胜",
      "source_seconds": 4724.43,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "共同养育不完全一致时，先别让孩子独自留在原地",
      "source_seconds": 5492.75,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "给精力一个出口，与替ADHD下结论是不同任务",
      "source_seconds": 5840.75,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "学习的中间地带，本来就可能令人挫败",
      "source_seconds": 6399.55,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "父母也需要资源，不能只在自责里听养育建议",
      "source_seconds": 6768.639,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "看到孩子做到了，不必马上证明是自己的方法有用",
      "source_seconds": 7037.109,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "青少年需要远行，也需要一个可以回来的基地",
      "source_seconds": 7425.31,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "家庭会议的价值，在于一起面对问题，而非集体宣布判决",
      "source_seconds": 7991.079,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "照顾者有自己的生活，并不等于孩子被放在次要位置",
      "source_seconds": 8178.229,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "成人发生冲突后，不能让孩子独自解释整座房子的震动",
      "source_seconds": 8483.309,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "当生活范围明显缩小时，求助不应等待孩子完全同意",
      "source_seconds": 8666.469,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "一个孩子可以从多位成人那里，获得不同的好东西",
      "source_seconds": 9069.71,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "特权感在她看来，是对挫折越来越没有容纳空间",
      "source_seconds": 9371.75,
      "timestamp_provenance": "local_vtt_unverified"
    },
    {
      "title": "家务、等待与感谢，把原则放回每天的小事",
      "source_seconds": 9936.19,
      "timestamp_provenance": "local_vtt_unverified"
    }
  ],
