  "sections": [
    {
      "title": "冷水首先引起的，是一次迅速的应激反应",
      "source_seconds": 584.6,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "害怕冷，不等于缺乏意志力",
      "source_seconds": 937.399,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "冷空气、冷淋浴与浸水，不能按分钟直接换算",
      "source_seconds": 1094.799,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "褐色脂肪，是温度调节系统的一部分",
      "source_seconds": 1347.679,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "离开冷水以后，身体未必立刻开始回暖",
      "source_seconds": 1584.36,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "“适度应激”不是越难受越有效",
      "source_seconds": 1744.84,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "适应以后，变化未必只在“更能忍”",
      "source_seconds": 1971.88,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "褐色脂肪可以改变，但病理状态不是健康目标",
      "source_seconds": 2347.4,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "温和环境变化，与极冷挑战是不同问题",
      "source_seconds": 2755.119,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "北欧生活经验，不能直接当成免疫疗法证据",
      "source_seconds": 3393.48,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "一项冬泳研究，是怎样从问题变成实验的",
      "source_seconds": 3624.119,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "选择已经适应的年轻男性，带来了清楚的范围",
      "source_seconds": 4255.08,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "潜水反射，不等于冷水已经变得安全",
      "source_seconds": 4624.76,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "他们实际观察到的，是冷水和桑拿结合的习惯",
      "source_seconds": 4773.48,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "研究者同时测量了感受、温度和组织信号",
      "source_seconds": 5044.48,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "最值得避免的简化，是“冬泳让褐脂始终更活跃”",
      "source_seconds": 5271.44,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "血糖和胰岛素的结果，需要放回受试者背景",
      "source_seconds": 5341.36,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "每周 11 分钟与 57 分钟，是观察总量而非普遍门槛",
      "source_seconds": 5521.76,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "芬兰桑拿队列，不能替另一项研究划定安全上限",
      "source_seconds": 5550.76,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "好睡眠和好心情，是线索，也可能只是尚未测量的体验",
      "source_seconds": 5948.239,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "裸泳不是获得生理效应的必要条件",
      "source_seconds": 6124.36,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "一个没有检测到褐脂信号的人，提出了新的问题",
      "source_seconds": 6477.32,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "炎症机制，尚不足以证明预防一长串疾病",
      "source_seconds": 6762.239,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "以冷结束，是一个特定目标下的建议，不是安全规则",
      "source_seconds": 6942.679,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "空腹与雷诺现象，最需要的是承认不知道",
      "source_seconds": 7185.52,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "把头浸下去，并不是更完整的健康版本",
      "source_seconds": 7534.96,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "游得很好，也可能在冷水中失温",
      "source_seconds": 7967.32,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "女性是否需要另一套时间，目前还没有答案",
      "source_seconds": 8241.76,
      "timestamp_provenance": "local_vtt_unverified_audio"
    },
    {
      "title": "调温值得研究，生活却不必变成温度竞赛",
      "source_seconds": 8534.92,
      "timestamp_provenance": "local_vtt_unverified_audio"
    }
